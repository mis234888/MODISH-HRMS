# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=documents

# Flask app
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
PORT=5000
USE_MOCK_DATA=false

# Admin access control — only these comma-separated emails can log in
ADMIN_EMAILS=xyz.com
# Required password for admin sign-in
ADMIN_PASSWORD=xyz

# Office timezone for every clock in the app (IANA name, or +05:30 for a fixed offset)
APP_TIMEZONE=Asia/Kolkata

# Secure production cookies: true behind HTTPS; false for local HTTP development
SESSION_COOKIE_SECURE=false

# Chat (see CHAT_SETUP.md). Required for Supabase; generate once, back up privately.
# CHAT_ENCRYPTION_KEY=<Fernet key generated locally; never commit the real value>
# Demo chat uses data/chat.sqlite3 + data/chat.key, separate from resettable HR demo data.
# CHAT_DATA_DIR=<optional private directory for demo chat>

# Optional Web Push: all three are required for notifications with the tab closed.
# Generate a VAPID pair with tools/chat_keys.py; keep private keys outside git.
# CHAT_VAPID_PUBLIC_KEY=<base64url public key>
# CHAT_VAPID_PRIVATE_KEY=<base64url private key>
# CHAT_VAPID_SUBJECT=mailto:your-admin@example.com
